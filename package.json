{
  "name": "jogo-da-memoria-ea",
  "version": "1.0.5",
  "private": true,
  "description": "Jogo da Memória EA para congressos, em totem Windows vertical.",
  "author": "Esthetic Aligner",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "build": "tsc --noEmit && vite build",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "npm run build && node tests/run-desktop.cjs",
    "server": "node server/index.cjs",
    "check": "node --check desktop/main.cjs && node --check desktop/store.cjs && node --check desktop/email.cjs && node --check server/index.cjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sql.js": "^1.13.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  },
  "build": {
    "appId": "br.com.estheticaligner.memoria",
    "productName": "Jogo da Memória EA",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "desktop/**/*", "shared/**/*", "build/icon.ico", "package.json"],
    "asar": true,
    "win": { "target": "nsis", "icon": "build/icon.ico", "artifactName": "Jogo-da-Memoria-EA-${version}-Setup.${ext}" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Jogo da Memória EA"
    }
  }
}
